# Supabase Edge Function secrets — NOT read by the Flutter client.
# Use with the Supabase CLI: `supabase secrets set --env-file .env`
# (or set each one individually with `supabase secrets set KEY=value`).
# Never put these in env.json or any --dart-define — that file ships to
# the browser. See docs/DEPLOYMENT.md section 5.
#
# For the Flutter client's own config (Supabase URL/anon key), copy
# env.json.example to env.json instead — that's a separate file.
AI_API_KEY=YOUR_SERVER_ONLY_PROVIDER_KEY
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
